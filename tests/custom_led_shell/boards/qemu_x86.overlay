/* qemu_x86 has no GPIO: add the emulator native_sim has, to run the test locally.
 * A board overlay replaces app.overlay, so include it. */
#include "../app.overlay"

/ {
	gpio0: gpio_emul {
		status = "okay";
		compatible = "zephyr,gpio-emul";
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		gpio-controller;
		#gpio-cells = <2>;
	};
};
